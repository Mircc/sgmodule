# ============ 合并去重域名集（anti-AD / AdBlock Surge / 各源域名）============
# 该域名集由本仓库定时重新生成，Surge 会随模块自动更新
DOMAIN-SET,https://raw.githubusercontent.com/Mircc/sgmodule/main/AD-Rules/adblock-cn-domains.txt,REJECT

# =============================================================================
#  以下规则需要开启 MITM（HTTPS 解密）方可生效
# -----------------------------------------------------------------------------
#  URL-REGEX / USER-AGENT 这类规则需要读取加密流量中的内容才能匹配，
#  因此必须在 Surge -> 首页 -> 解密 HTTPS 流量（MITM）中为本模块列出的主机名
#  开启解密，否则这些规则不会命中。
#
#  风险提示：MITM 会解密对应域名的流量，请只对可信域名开启；
#          网银、支付、政务类 App 不建议开启 MITM。
#          本模块已尽量剔除需要 MITM 的规则，默认主体规则均无需解密即可生效。
# =============================================================================

# ---- 来源：Blockads 软件去广告合集 ----
# ======= G ======= #
# ======= H ======= #
# ======= I ======= #
# ======= J ======= #
# 京东
URL-REGEX,"^http:\/\/\w{32}\.jddebug\.com\/diagnose\?",REJECT,pre-matching,extended-matching
# ======= L ======= #
# Line
URL-REGEX,"^https:\/\/a\.line\.me\/er\/lads\/v\d\/ei\?",REJECT-TINYGIF
URL-REGEX,"^https:\/\/a\.line\.me\/er\/l.*\/v\d\/event\/image",REJECT-TINYGIF
URL-REGEX,"^https:\/\/a\.line\.me\/lass\/api\/v\d\/ads$",REJECT-DROP
URL-REGEX,"^https:\/\/a\.line\.me\/oa\/v\d\/e$",REJECT-DROP
URL-REGEX,"^https:\/\/a\.line\.me\/cs\/v\d\/oa$",REJECT-DROP
URL-REGEX,"^https:\/\/w\.line\.me\/adp\/api\/ad\/v\d\/",REJECT-DROP
URL-REGEX,"^https:\/\/crs-event\.line\.me\/v\d\/imp",REJECT-DROP
URL-REGEX,"^https:\/\/sch\.line\.me\/api\/v\d\/ads$",REJECT-DROP
URL-REGEX,"^https:\/\/uts-front\.line-apps\.com\/event$",REJECT-DROP
URL-REGEX,"^https:\/\/uts-front\.line-apps\.com\/settings$",REJECT-DROP
URL-REGEX,"^https:\/\/obs\.line-scdn\.net\/0h[a-zA-Z0-9_-]{50}[a-zA-Z0-9_-]*",REJECT-DROP
URL-REGEX,"^https:\/\/obs\.line-scdn\.net\/0h.+\/(o|m)\d+x\d+$",REJECT-DROP
URL-REGEX,"^https:\/\/obs\.line-scdn\.net\/0hGH\d",REJECT-DROP
URL-REGEX,"^https:\/\/obs\.line-scdn\.net\/0h.+\/\d+p\.mp4$",REJECT-DROP
URL-REGEX,"^https:\/\/obs\.line-scdn\.net\/r\/linecrs\/.+\/m180x180$",REJECT-TINYGIF
URL-REGEX,"^https:\/\/ec-bot-obs\.line-scdn\.net\/0h[0-9a-zA-Z_-]{50}[0-9a-zA-Z_-]*",REJECT-TINYGIF
URL-REGEX,"^https:\/\/d\.line-scdn\.net\/lcp-prod-photo\/20.+\.(jpg|jpeg|png)",REJECT-TINYGIF
URL-REGEX,"^https:\/\/web-mmap-pay\.line-apps\.com\/tw\/liff\/campaign\/v\d\/aggregate\/ad\/banner\/",REJECT-TINYGIF
URL-REGEX,"^https:\/\/scdn\.line-apps\.com\/lan\/image\/line\/bannerImageEvent\/",REJECT-DROP
URL-REGEX,"^https:\/\/scdn\.line-apps\.com\/lan\/document\/pageEvent\/line\/ios\/",REJECT-DROP
# 航旅纵横
URL-REGEX,"^http?:\/\/(discardrp|startup)\.umetrip\.com\/gateway\/api\/umetrip\/native",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/.+\/amdc\/mobileDispatch",REJECT,pre-matching,extended-matching
USER-AGENT,"httpdns*",REJECT,pre-matching,extended-matching
USER-AGENT,"httpsdns*",REJECT,pre-matching,extended-matching
USER-AGENT,"Httpdns*",REJECT,pre-matching,extended-matching
USER-AGENT,"Httpsdns*",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\](?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/103\.44\.58\.64\/md\?",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/cdn\.wup\.huya\.com\/launch\/queryHttpDns",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/xmc\.ximalaya\.com\/xmlymain-login-web\/login\/",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/103\.37\.155\.60\/fetch",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/api\.weibo\.cn\/\d+\/httpdns\/config",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/api\.weibo\.cn\/httpdns\/config",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/v\d\/resolv\?",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?):\d+\/httpdns\/",REJECT,pre-matching,extended-matching
URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\]:\d+\/httpdns\/",REJECT,pre-matching,extended-matching

[MITM]
# 仅上面「需要 MITM」的规则会用到；不使用这些规则可删除本段
hostname = %APPEND% a.line.me, ad.line-scdn.net, api.weibo.cn, buy.line.me, cdn.wup.huya.com, cix.line-apps.com, crs-event.line.me, d.line-scdn.net, ec-bot-obs.line-scdn.net, home.umetrip.com, jddebug.com, lan.line.me, legy.line-apps.com, obs.line-scdn.net, oss.umetrip.com, scdn.line-apps.com, sch.line.me, static.line-scdn.net, umetrip.com, uts-front.line-apps.com, w.line.me, web-mmap-pay.line-apps.com, xmc.ximalaya.com
